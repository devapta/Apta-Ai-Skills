	__entities__ := make([]models.__Entity__Page, 0)

	stmt := r.db.WithContext(c.Request.Context()).Raw(r.pageQuery)

	pg := paginate.New()

	page := pg.With(stmt).Request(c.Request).Response(&__entities__)

