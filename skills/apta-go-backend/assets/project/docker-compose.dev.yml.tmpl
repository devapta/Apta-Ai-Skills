services:
  __APP_NAME__-migrate:
    image: registry.apta.works/__APP_NAME__:latest
    pull_policy: always
    container_name: __APP_NAME__-migrate
    networks:
      - infra-app
    env_file:
      - .env
    command: ["migrate"]

  __APP_NAME__:
    image: registry.apta.works/__APP_NAME__:latest
    pull_policy: always
    container_name: __APP_NAME__
    restart: always
    networks:
      - infra-app
    env_file:
      - .env
    depends_on:
      __APP_NAME__-migrate:
        condition: service_completed_successfully

networks:
  infra-app:
    external: true
    name: infra-app