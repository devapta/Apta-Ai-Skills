package routes

import (
	"__MODULE__/cloud/internal/v1/handlers"
	"__MODULE__/cloud/internal/v1/middlewares"
	"github.com/gin-gonic/gin"
	"go.uber.org/dig"
)

// APIHandlers bundles every API (v1) handler.
type APIHandlers struct {
	dig.In

	User          *handlers.UserHandler
	Role          *handlers.RoleHandler
	UserRole      *handlers.UserRoleHandler
	Site          *handlers.SiteHandler
	SchemaM       *middlewares.SchemaMiddleware
	// scaffold:api-handlers
}

func SetupRoutes(api *gin.RouterGroup, h APIHandlers) {
	authM := middlewares.NewAuthMiddleware()

	v1 := api.Group("/v1")
	setupUserRoutes(v1, authM, h.User, h.SchemaM)
	setupRoleRoutes(v1, authM, h.Role, h.SchemaM)
	setupUserRoleRoutes(v1, authM, h.UserRole, h.SchemaM)
	setupSiteRoutes(v1, authM, h.Site)
	// scaffold:routes
}
