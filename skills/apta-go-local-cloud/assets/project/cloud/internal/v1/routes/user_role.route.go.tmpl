package routes

import (
	"__MODULE__/cloud/internal/v1/handlers"
	"__MODULE__/cloud/internal/v1/middlewares"
	"github.com/gin-gonic/gin"
)

func setupUserRoleRoutes(v1 *gin.RouterGroup, authM *middlewares.AuthMiddleware, h *handlers.UserRoleHandler, schemaM *middlewares.SchemaMiddleware) {
	userRoles := v1.Group("/user-roles", authM.Authn)

	userRoles.POST("/", h.Create)
	userRoles.GET("/", schemaM.SchemaRouter, h.Read)
	userRoles.GET("/:id", schemaM.SchemaRouter, h.GetByID)
	userRoles.PUT("/:id", h.Update)
	userRoles.DELETE("/:id", h.Delete)
}
