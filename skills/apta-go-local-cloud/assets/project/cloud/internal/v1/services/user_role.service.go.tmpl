package services

import (
	"context"

	"__MODULE__/cloud/internal/v1/models"
	"__MODULE__/cloud/internal/v1/repositories"
	"__MODULE__/shared/common"
	"__MODULE__/shared/entities"
	"github.com/gin-gonic/gin"
	"github.com/morkid/paginate"
)

type IUserRoleService interface {
	common.IBaseCrudService[entities.UserRole, models.UserRoleInput, models.UserRolePage]
	UseScoped(c *gin.Context) IUserRoleService
}

type UserRoleService struct {
	repo repositories.IUserRoleRepo
}

var _ IUserRoleService = &UserRoleService{}

func NewUserRoleService(repo repositories.IUserRoleRepo) *UserRoleService {
	return &UserRoleService{
		repo: repo,
	}
}

func (s *UserRoleService) Create(c context.Context, input models.UserRoleInput) (uint, error) {
	return s.repo.Create(c, input)
}

func (s *UserRoleService) Read(c *gin.Context) (paginate.Page, []models.UserRolePage) {
	return s.repo.Read(c)
}

func (s *UserRoleService) Update(c context.Context, id any, input models.UserRoleInput) error {
	return s.repo.Update(c, id, input)
}

func (s *UserRoleService) Delete(c context.Context, id any) error {
	return s.repo.Delete(c, id)
}

func (s *UserRoleService) GetByID(c context.Context, id any) (entities.UserRole, error) {
	return s.repo.GetByID(c, id)
}

// UseScoped returns the service bound to the request's schema-scoped transaction, or the service
// itself when the request was not scoped.
func (s *UserRoleService) UseScoped(c *gin.Context) IUserRoleService {
	tx, ok := scopedTx(c)
	if !ok {
		return s
	}

	return NewUserRoleService(repositories.NewUserRoleRepo(tx))
}
