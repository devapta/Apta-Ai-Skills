	for _, table := range cloudAuthorityTables {
		db.Exec(fmt.Sprintf(`ALTER TABLE %s ADD COLUMN IF NOT EXISTS "_PEERDB_IS_DELETED" bool DEFAULT false NULL`, table))
		db.Exec(fmt.Sprintf(`ALTER TABLE %s ADD COLUMN IF NOT EXISTS "_PEERDB_SYNCED_AT" timestamp DEFAULT CURRENT_TIMESTAMP NULL`, table))
	}

	fmt.Println("Database Migrated")

	return err
}

